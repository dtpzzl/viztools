{
  "_comment": "Configuration des APIs DataPuzzle. NE PAS mettre de clés API ici. Les clés vont dans les variables d'environnement Vercel.",
  "_version": "1.0",
  "apis": [
    {
      "id": "datagouv",
      "name": "data.gouv.fr",
      "url": "https://www.data.gouv.fr/api/1",
      "type": "datagouv",
      "builtin": true,
      "status": "active",
      "auth": "none",
      "doc_url": "https://guides.data.gouv.fr/api",
      "description": "Catalogue officiel des données publiques françaises",
      "facets": [
        {
          "key": "topic",
          "label": "Thème",
          "type": "select",
          "values": [
            "transport",
            "housing",
            "health",
            "education",
            "economy",
            "environment",
            "society",
            "culture",
            "security",
            "agriculture",
            "energy",
            "spatial-planning",
            "justice",
            "employment"
          ],
          "labels": {
            "transport": "Transport",
            "housing": "Logement",
            "health": "Santé",
            "education": "Éducation",
            "economy": "Économie",
            "environment": "Environnement",
            "society": "Social",
            "culture": "Culture",
            "security": "Sécurité",
            "agriculture": "Agriculture",
            "energy": "Énergie",
            "spatial-planning": "Aménagement",
            "justice": "Justice",
            "employment": "Emploi"
          }
        },
        {
          "key": "frequency",
          "label": "Fréquence",
          "type": "select",
          "values": [
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "annual",
            "unknown"
          ],
          "labels": {
            "daily": "Quotidien",
            "weekly": "Hebdomadaire",
            "monthly": "Mensuel",
            "quarterly": "Trimestriel",
            "annual": "Annuel",
            "unknown": "Inconnu"
          }
        },
        {
          "key": "license",
          "label": "Licence",
          "type": "select",
          "values": [
            "fr-lo",
            "odc-odbl",
            "cc-by",
            "cc-by-sa",
            "other-open"
          ]
        },
        {
          "key": "organization",
          "label": "Organisation",
          "type": "text",
          "placeholder": "ex: insee"
        },
        {
          "key": "tag",
          "label": "Tag",
          "type": "text",
          "placeholder": "ex: emploi, chômage"
        }
      ],
      "query_params": {
        "page_size": 8,
        "sort": "-created"
      },
      "example_queries": [
        "chômage",
        "température",
        "immigration",
        "logement",
        "salaires"
      ]
    },
    {
      "id": "insee-bdm",
      "name": "INSEE — BDM",
      "url": "https://bdm.insee.fr/series/sdmx",
      "type": "insee-bdm",
      "builtin": true,
      "status": "active",
      "auth": "none",
      "doc_url": "https://portail-api.insee.fr/catalog/api/eebab65a-9aef-4da5-bab6-5a9aefeda552",
      "description": "Banque de données macroéconomiques INSEE — 150 000+ séries chronologiques",
      "facets": [
        {
          "key": "idBank",
          "label": "Identifiant série (idBank)",
          "type": "text",
          "placeholder": "ex: 001694087"
        },
        {
          "key": "theme",
          "label": "Thème",
          "type": "select",
          "values": [
            "Prix",
            "Emploi",
            "Salaires",
            "Population",
            "PIB",
            "Commerce",
            "Industrie",
            "Construction",
            "Agriculture",
            "Démographie"
          ]
        },
        {
          "key": "frequency",
          "label": "Fréquence",
          "type": "select",
          "values": [
            "M (mensuelle)",
            "T (trimestrielle)",
            "A (annuelle)"
          ]
        },
        {
          "key": "geo",
          "label": "Territoire",
          "type": "select",
          "values": [
            "France",
            "Île-de-France",
            "Métropole",
            "DOM-TOM",
            "Région",
            "Département"
          ]
        }
      ],
      "query_params": {},
      "example_queries": [
        "Taux de chômage — 001694087",
        "IPC — 001759665",
        "PIB trimestriel — 010605539"
      ],
      "notes": "L'API BDM est en accès libre sans clé. Les séries sont identifiées par leur idBank disponible sur insee.fr."
    },
    {
      "id": "infoclimat",
      "name": "Infoclimat",
      "url": "https://www.infoclimat.fr/public-api",
      "type": "infoclimat",
      "builtin": true,
      "status": "key_required",
      "auth": "api_key",
      "env_key": "INFOCLIMAT_KEY",
      "doc_url": "https://www.infoclimat.fr/opendata/",
      "description": "Données météo historiques et temps réel — réseau de stations France",
      "facets": [
        {
          "key": "station",
          "label": "Station (ID)",
          "type": "text",
          "placeholder": "ex: 07149 (Brest)"
        },
        {
          "key": "format",
          "label": "Format",
          "type": "select",
          "values": [
            "json",
            "csv"
          ]
        },
        {
          "key": "debut",
          "label": "Date début",
          "type": "text",
          "placeholder": "ex: 2024-01-01"
        },
        {
          "key": "fin",
          "label": "Date fin",
          "type": "text",
          "placeholder": "ex: 2024-12-31"
        },
        {
          "key": "methode",
          "label": "Résolution",
          "type": "select",
          "values": [
            "horaire",
            "quotidienne",
            "mensuelle"
          ]
        }
      ],
      "query_params": {},
      "example_queries": [
        "Températures Brest 2024",
        "Précipitations Paris 2023",
        "Vent Marseille 2024"
      ],
      "notes": "Clé API gratuite pour usage non-commercial. Créer un compte sur infoclimat.fr > Open Data puis renseigner la clé dans Vercel sous INFOCLIMAT_KEY."
    },
    {
      "id": "meteofrance",
      "name": "Météo-France",
      "url": "https://public-api.meteofrance.fr/public",
      "type": "meteofrance",
      "builtin": true,
      "status": "key_required",
      "auth": "api_key",
      "env_key": "METEOFRANCE_KEY",
      "doc_url": "https://portail-api.meteofrance.fr/web/",
      "description": "Données officielles Météo-France — observations, prévisions, climatologie",
      "facets": [
        {
          "key": "dataset",
          "label": "Jeu de données",
